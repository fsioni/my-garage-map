{
  "name": "garage-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for personal vehicle history",
  "keywords": [
    "automotive",
    "effect",
    "mcp",
    "model-context-protocol",
    "sqlite",
    "typescript",
    "vehicle-maintenance"
  ],
  "homepage": "https://github.com/fsioni/my-garage-map#readme",
  "bugs": {
    "url": "https://github.com/fsioni/my-garage-map/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsioni/my-garage-map.git"
  },
  "author": {
    "name": "Farès SIONI",
    "url": "https://github.com/fsioni"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "garage-mcp": "./dist/main.js"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "esbuild": "0.28.1"
    }
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate-cli.ts",
    "seed": "tsx src/infrastructure/database/seed.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@fast-check/vitest": "0.4.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.10",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
